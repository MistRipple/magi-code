{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magi.dev/contracts/desktop-ipc.schema.json",
  "title": "Magi Desktop renderer IPC envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel", "payload"],
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "magi-desktop:get-snapshot",
        "magi-desktop:set-context",
        "magi-desktop:layout-intent",
        "magi-desktop:activate-browser",
        "magi-desktop:register-browser-webview",
        "magi-desktop:update-browser-display-size",
        "magi-desktop:release-browser-webview",
        "magi-desktop:wait-for-browser-surface",
        "magi-desktop:activate-panel",
        "magi-desktop:set-browser-viewport",
        "magi-desktop:cancel-browser-download",
        "magi-desktop:start-browser-inspect",
        "magi-desktop:stop-browser-inspect",
        "magi-desktop:start-browser-annotation-capture",
        "magi-desktop:stop-browser-annotation-capture",
        "magi-desktop:right-pane-ready",
        "magi-desktop:focus-app",
        "magi-desktop:open-external",
        "magi-desktop:show-context-menu",
        "magi-desktop:open-workspace-folder",
        "magi-desktop:reveal-workspace-file",
        "magi-desktop:set-appearance",
        "magi-desktop:get-app-version",
        "magi-desktop:get-browser-component-info",
        "magi-desktop:restart-browser-automation",
        "magi-desktop:clear-browser-data",
        "magi-desktop:check-for-updates",
        "magi-desktop:download-update",
        "magi-desktop:install-update"
      ]
    },
    "payload": {}
  },
  "oneOf": [
    { "$ref": "#/$defs/getSnapshot" },
    { "$ref": "#/$defs/setContext" },
    { "$ref": "#/$defs/layoutIntentChannel" },
    { "$ref": "#/$defs/activateBrowser" },
    { "$ref": "#/$defs/registerBrowserWebview" },
    { "$ref": "#/$defs/updateBrowserDisplaySize" },
    { "$ref": "#/$defs/releaseBrowserWebview" },
    { "$ref": "#/$defs/waitForBrowserSurface" },
    { "$ref": "#/$defs/activatePanel" },
    { "$ref": "#/$defs/setBrowserViewport" },
    { "$ref": "#/$defs/cancelBrowserDownload" },
    { "$ref": "#/$defs/startBrowserInspect" },
    { "$ref": "#/$defs/stopBrowserInspect" },
    { "$ref": "#/$defs/startBrowserAnnotationCapture" },
    { "$ref": "#/$defs/stopBrowserAnnotationCapture" },
    { "$ref": "#/$defs/rightPaneReady" },
    { "$ref": "#/$defs/focusApp" },
    { "$ref": "#/$defs/openExternal" },
    { "$ref": "#/$defs/showContextMenu" },
    { "$ref": "#/$defs/openWorkspaceFolder" },
    { "$ref": "#/$defs/revealWorkspaceFile" },
    { "$ref": "#/$defs/setAppearance" },
    { "$ref": "#/$defs/getAppVersion" },
    { "$ref": "#/$defs/getBrowserComponentInfo" },
    { "$ref": "#/$defs/restartBrowserAutomation" },
    { "$ref": "#/$defs/clearBrowserData" },
    { "$ref": "#/$defs/checkForUpdates" },
    { "$ref": "#/$defs/downloadUpdate" },
    { "$ref": "#/$defs/installUpdate" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "optionalText": { "type": ["string", "null"] },
    "empty": { "type": "null" },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "browserDisplaySize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "viewport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "auto" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "width",
            "height",
            "deviceScaleFactorMillis",
            "deviceType"
          ],
          "properties": {
            "mode": { "const": "fixed" },
            "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 240, "maximum": 4320 },
            "deviceScaleFactorMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            },
            "deviceType": { "enum": ["desktop", "mobile"] }
          }
        }
      ]
    },
    "layoutIntent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "width"],
          "properties": {
            "type": { "const": "right_pane_width" },
            "width": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "right_pane_reset_width" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "visible"],
          "properties": {
            "type": { "const": "right_pane_visibility" },
            "visible": { "type": "boolean" }
          }
        }
      ]
    },
    "browserActivationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabId",
        "browserSessionId",
        "url",
        "navigationRevision",
        "viewport"
      ],
      "properties": {
        "tabId": { "$ref": "#/$defs/id" },
        "browserSessionId": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "minLength": 1 },
        "navigationRevision": { "type": "number", "minimum": 0 },
        "viewport": { "$ref": "#/$defs/viewport" }
      }
    },
    "registerBrowserWebview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:register-browser-webview" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tabId",
            "browserSessionId",
            "navigationRevision",
            "webContentsId",
            "displaySize"
          ],
          "properties": {
            "tabId": { "$ref": "#/$defs/id" },
            "browserSessionId": { "$ref": "#/$defs/id" },
            "navigationRevision": { "type": "integer", "minimum": 0 },
            "webContentsId": { "type": "integer", "minimum": 1 },
            "displaySize": { "$ref": "#/$defs/browserDisplaySize" }
          }
        }
      }
    },
    "updateBrowserDisplaySize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:update-browser-display-size" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tabId",
            "browserSessionId",
            "navigationRevision",
            "webContentsId",
            "displaySize"
          ],
          "properties": {
            "tabId": { "$ref": "#/$defs/id" },
            "browserSessionId": { "$ref": "#/$defs/id" },
            "navigationRevision": { "type": "integer", "minimum": 0 },
            "webContentsId": { "type": "integer", "minimum": 1 },
            "displaySize": { "$ref": "#/$defs/browserDisplaySize" }
          }
        }
      }
    },
    "releaseBrowserWebview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:release-browser-webview" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tabId",
            "browserSessionId",
            "navigationRevision",
            "webContentsId"
          ],
          "properties": {
            "tabId": { "$ref": "#/$defs/id" },
            "browserSessionId": { "$ref": "#/$defs/id" },
            "navigationRevision": { "type": "integer", "minimum": 0 },
            "webContentsId": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "browserInspectPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabId", "surfaceId", "navigationRevision"],
      "properties": {
        "tabId": { "$ref": "#/$defs/id" },
        "surfaceId": { "$ref": "#/$defs/id" },
        "navigationRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "panelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tabId"],
      "properties": {
        "kind": { "enum": ["agent", "browser", "code", "terminal", null] },
        "tabId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "contextMenuItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "role"],
          "properties": {
            "type": { "const": "role" },
            "role": {
              "enum": ["undo", "redo", "cut", "copy", "paste", "selectAll"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "separator" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "label"],
          "properties": {
            "type": { "const": "action" },
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "label": { "type": "string", "minLength": 1, "maxLength": 160 },
            "enabled": { "type": "boolean" }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "backgroundColor", "accentColor", "material"],
      "properties": {
        "mode": { "enum": ["light", "dark"] },
        "backgroundColor": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}(?:\\s*,\\s*(?:0(?:\\.\\d+)?|1(?:\\.0+)?|0?\\.\\d+))?\\s*\\))$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}(?:\\s*,\\s*(?:0(?:\\.\\d+)?|1(?:\\.0+)?|0?\\.\\d+))?\\s*\\))$"
        },
        "material": { "enum": ["clear", "translucent", "immersive"] }
      }
    },
    "revealFilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPathRef", "workspaceRootPathRef"],
      "properties": {
        "targetPathRef": { "$ref": "#/$defs/id" },
        "workspaceRootPathRef": { "$ref": "#/$defs/id" }
      }
    },
    "contextMenuPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/contextMenuItem" }
        }
      }
    },
    "contextPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": { "$ref": "#/$defs/optionalText" },
        "workspacePath": { "$ref": "#/$defs/optionalText" },
        "sessionId": { "$ref": "#/$defs/optionalText" }
      }
    },
    "getSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:get-snapshot" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "setContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:set-context" },
        "payload": { "$ref": "#/$defs/contextPayload" }
      }
    },
    "layoutIntentChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:layout-intent" },
        "payload": { "$ref": "#/$defs/layoutIntent" }
      }
    },
    "activateBrowser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:activate-browser" },
        "payload": { "$ref": "#/$defs/browserActivationPayload" }
      }
    },
    "waitForBrowserSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:wait-for-browser-surface" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tabId"],
          "properties": { "tabId": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "activatePanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:activate-panel" },
        "payload": { "$ref": "#/$defs/panelPayload" }
      }
    },
    "setBrowserViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:set-browser-viewport" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tabId", "viewport"],
          "properties": {
            "tabId": { "$ref": "#/$defs/id" },
            "viewport": { "$ref": "#/$defs/viewport" }
          }
        }
      }
    },
    "cancelBrowserDownload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:cancel-browser-download" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tabId", "downloadId"],
          "properties": {
            "tabId": { "$ref": "#/$defs/id" },
            "downloadId": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "startBrowserInspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:start-browser-inspect" },
        "payload": { "$ref": "#/$defs/browserInspectPayload" }
      }
    },
    "stopBrowserInspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:stop-browser-inspect" },
        "payload": { "$ref": "#/$defs/browserInspectPayload" }
      }
    },
    "startBrowserAnnotationCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:start-browser-annotation-capture" },
        "payload": { "$ref": "#/$defs/browserInspectPayload" }
      }
    },
    "stopBrowserAnnotationCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:stop-browser-annotation-capture" },
        "payload": { "$ref": "#/$defs/browserInspectPayload" }
      }
    },
    "rightPaneReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:right-pane-ready" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "focusApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:focus-app" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "openExternal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:open-external" },
        "payload": { "type": "string", "minLength": 1 }
      }
    },
    "showContextMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:show-context-menu" },
        "payload": { "$ref": "#/$defs/contextMenuPayload" }
      }
    },
    "openWorkspaceFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:open-workspace-folder" },
        "payload": { "type": "string", "minLength": 1 }
      }
    },
    "revealWorkspaceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:reveal-workspace-file" },
        "payload": { "$ref": "#/$defs/revealFilePayload" }
      }
    },
    "setAppearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:set-appearance" },
        "payload": { "$ref": "#/$defs/appearance" }
      }
    },
    "getAppVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:get-app-version" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "getBrowserComponentInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:get-browser-component-info" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "restartBrowserAutomation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:restart-browser-automation" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "clearBrowserData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:clear-browser-data" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "checkForUpdates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:check-for-updates" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "downloadUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:download-update" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    },
    "installUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "payload"],
      "properties": {
        "channel": { "const": "magi-desktop:install-update" },
        "payload": { "$ref": "#/$defs/empty" }
      }
    }
  }
}
