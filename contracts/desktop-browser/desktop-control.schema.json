{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magi.dev/contracts/desktop-control.schema.json",
  "title": "Magi Desktop Browser control protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "protocol_version", "command"],
  "properties": {
    "request_id": { "$ref": "#/$defs/id" },
    "protocol_version": { "$ref": "#/$defs/protocolVersion" },
    "command": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "surfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop_epoch",
        "window_id",
        "surface_id",
        "surface_revision",
        "tab_id",
        "web_contents_id",
        "target_id",
        "browser_context_id",
        "navigation_revision"
      ],
      "properties": {
        "desktop_epoch": { "$ref": "#/$defs/id" },
        "window_id": { "$ref": "#/$defs/id" },
        "surface_id": { "$ref": "#/$defs/id" },
        "surface_revision": { "type": "integer", "minimum": 0 },
        "tab_id": { "$ref": "#/$defs/id" },
        "web_contents_id": { "type": "integer", "minimum": 1 },
        "target_id": { "$ref": "#/$defs/id" },
        "browser_context_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "surfaceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "surface_id", "navigation_revision"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "surface_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "nodeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "surface_id",
        "navigation_revision",
        "browser_session_id",
        "url",
        "title",
        "frame_id",
        "backend_dom_node_id",
        "dom_node_id",
        "node_name",
        "attributes",
        "text_excerpt",
        "outer_html",
        "outer_html_truncated",
        "aria_role",
        "aria_name",
        "bounds"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "surface_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "browser_session_id": { "$ref": "#/$defs/id" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "frame_id": { "type": ["string", "null"] },
        "backend_dom_node_id": { "type": "integer", "minimum": 1 },
        "dom_node_id": { "type": ["integer", "null"], "minimum": 1 },
        "node_name": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "text_excerpt": { "type": "string" },
        "outer_html": { "type": "string" },
        "outer_html_truncated": { "type": "boolean" },
        "aria_role": { "type": ["string", "null"] },
        "aria_name": { "type": ["string", "null"] },
        "bounds": {
          "oneOf": [{ "$ref": "#/$defs/normalizedRect" }, { "type": "null" }]
        }
      }
    },
    "logicalViewport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "auto" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "width",
            "height",
            "device_scale_factor_millis",
            "device_type"
          ],
          "properties": {
            "mode": { "const": "fixed" },
            "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 240, "maximum": 4320 },
            "device_scale_factor_millis": { "type": "integer", "minimum": 1 },
            "device_type": { "enum": ["desktop", "mobile"] }
          }
        }
      ]
    },
    "control": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "lease_id", "fence"],
          "properties": {
            "mode": { "const": "agent" },
            "lease_id": { "$ref": "#/$defs/id" },
            "fence": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fence"],
          "properties": {
            "mode": { "const": "user" },
            "fence": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "controlUpdate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "lease_id", "fence"],
          "properties": {
            "mode": { "const": "agent" },
            "lease_id": { "$ref": "#/$defs/id" },
            "fence": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fence"],
          "properties": {
            "mode": { "const": "user" },
            "fence": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fence"],
          "properties": {
            "mode": { "const": "released" },
            "fence": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "snapshotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_revision", "element_ref"],
      "properties": {
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "element_ref": { "$ref": "#/$defs/id" }
      }
    },
    "navigation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "url"],
          "properties": {
            "action": { "const": "url" },
            "url": { "type": "string", "minLength": 1 },
            "handle_before_unload": { "enum": ["accept", "dismiss"] },
            "init_script": { "type": "string" },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "back" },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "forward" },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "stop" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "const": "reload" },
            "ignore_cache": { "type": "boolean" },
            "handle_before_unload": { "enum": ["accept", "dismiss"] },
            "timeout_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "snapshotLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "max_text_bytes"],
      "properties": {
        "max_nodes": { "type": "integer", "minimum": 0 },
        "max_text_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "jsonValue": {},
    "pagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "browser_session_id",
        "initial_url",
        "logical_viewport",
        "navigation_revision",
        "snapshot_revision"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "browser_session_id": { "$ref": "#/$defs/id" },
        "initial_url": { "type": "string", "minLength": 1 },
        "logical_viewport": { "$ref": "#/$defs/logicalViewport" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "allow_page_eviction": { "type": "boolean" }
      }
    },
    "tabPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id"],
      "properties": { "tab_id": { "$ref": "#/$defs/id" } }
    },
    "setViewportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "viewport"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "viewport": { "$ref": "#/$defs/logicalViewport" }
      }
    },
    "annotationsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "annotations"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "navigatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "control", "navigation"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/control" },
        "navigation": { "$ref": "#/$defs/navigation" }
      }
    },
    "snapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "navigation_revision",
        "snapshot_revision",
        "limits"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "limits": { "$ref": "#/$defs/snapshotLimits" },
        "subtree_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "clickPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "control", "target"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/control" },
        "target": { "$ref": "#/$defs/snapshotTarget" }
      }
    },
    "typePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "control", "target", "text", "replace"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/control" },
        "target": { "$ref": "#/$defs/snapshotTarget" },
        "text": { "type": "string" },
        "replace": { "type": "boolean" },
        "submit_key": { "type": ["string", "null"] }
      }
    },
    "pressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "control", "key"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/control" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "scrollPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "control", "delta_x", "delta_y"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/control" },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/snapshotTarget" }, { "type": "null" }]
        },
        "delta_x": { "type": "number" },
        "delta_y": { "type": "number" }
      }
    },
    "devtoolsPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "operation", "arguments"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "control": {
          "oneOf": [{ "$ref": "#/$defs/control" }, { "type": "null" }]
        },
        "operation": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "screenshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "navigation_revision", "full_page", "format"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/snapshotTarget" }, { "type": "null" }]
        },
        "clip": {
          "oneOf": [{ "$ref": "#/$defs/normalizedRect" }, { "type": "null" }]
        },
        "full_page": { "type": "boolean" },
        "format": { "enum": ["png", "jpeg", "webp"] },
        "quality": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "hitTestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "navigation_revision",
        "normalized_x",
        "normalized_y"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "normalized_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalized_y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "updateControlPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "surface_id", "control"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "surface_id": { "$ref": "#/$defs/id" },
        "control": { "$ref": "#/$defs/controlUpdate" }
      }
    },
    "cancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": { "request_id": { "$ref": "#/$defs/id" } }
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "desktop_version",
        "electron_version",
        "chromium_version",
        "process_id",
        "desktop_epoch",
        "worker_epoch"
      ],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "desktop_version": { "type": "string" },
        "electron_version": { "type": "string" },
        "chromium_version": { "type": "string" },
        "process_id": { "type": "integer", "minimum": 0 },
        "desktop_epoch": { "$ref": "#/$defs/id" },
        "worker_epoch": { "$ref": "#/$defs/id" }
      }
    },
    "pageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tab_id", "url", "origin", "title", "navigation_revision"],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "url": { "type": "string" },
        "origin": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "navigation_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "snapshotNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_ref",
        "role",
        "name",
        "value",
        "description",
        "disabled",
        "focused",
        "editable",
        "visible",
        "bounds",
        "children"
      ],
      "properties": {
        "element_ref": { "$ref": "#/$defs/id" },
        "role": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "disabled": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "sensitive_input_kind": {
          "enum": ["password", "one_time_code", "payment_card", null]
        },
        "visible": { "type": "boolean" },
        "bounds": {
          "oneOf": [{ "$ref": "#/$defs/normalizedRect" }, { "type": "null" }]
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/snapshotNode" }
        }
      }
    },
    "accessibilityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "element_ref",
        "parent_id",
        "child_ids",
        "role",
        "name",
        "value",
        "description",
        "ignored",
        "properties",
        "actions",
        "backend_dom_node_id"
      ],
      "properties": {
        "node_id": { "type": "string" },
        "element_ref": { "type": ["string", "null"] },
        "parent_id": { "type": ["string", "null"] },
        "child_ids": { "type": "array", "items": { "type": "string" } },
        "role": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "ignored": { "type": "boolean" },
        "properties": { "type": "object" },
        "actions": { "type": "array", "items": { "type": "string" } },
        "backend_dom_node_id": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "navigation_revision",
        "snapshot_revision",
        "root",
        "returned_nodes",
        "total_nodes",
        "text_bytes",
        "truncated",
        "continuation_refs"
      ],
      "properties": {
        "tab_id": { "$ref": "#/$defs/id" },
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "root": { "$ref": "#/$defs/snapshotNode" },
        "returned_nodes": { "type": "integer", "minimum": 0 },
        "total_nodes": { "type": "integer", "minimum": 0 },
        "text_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "continuation_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "accessibility_tree": {
          "type": "array",
          "items": { "$ref": "#/$defs/accessibilityNode" }
        }
      }
    },
    "binaryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "mime_type", "byte_length", "sha256"],
      "properties": {
        "payload_id": { "$ref": "#/$defs/id" },
        "mime_type": { "type": "string" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" }
      }
    },
    "hitTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_revision",
        "viewport_width",
        "viewport_height",
        "device_scale_factor_millis",
        "scroll_x",
        "scroll_y",
        "element_ref",
        "tag_name",
        "test_id",
        "stable_id",
        "aria_role",
        "aria_name",
        "text_excerpt",
        "css_path",
        "ancestor_fingerprint",
        "dom_fingerprint",
        "bounds"
      ],
      "properties": {
        "navigation_revision": { "type": "integer", "minimum": 0 },
        "viewport_width": { "type": "integer", "minimum": 0 },
        "viewport_height": { "type": "integer", "minimum": 0 },
        "device_scale_factor_millis": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "scroll_x": { "type": "number" },
        "scroll_y": { "type": "number" },
        "element_ref": { "$ref": "#/$defs/id" },
        "tag_name": { "type": "string" },
        "test_id": { "type": ["string", "null"] },
        "stable_id": { "type": ["string", "null"] },
        "aria_role": { "type": ["string", "null"] },
        "aria_name": { "type": ["string", "null"] },
        "text_excerpt": { "type": ["string", "null"] },
        "css_path": { "type": "string" },
        "ancestor_fingerprint": { "type": "string" },
        "dom_fingerprint": { "type": "string" },
        "bounds": { "$ref": "#/$defs/normalizedRect" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "recoverable",
        "side_effect_started",
        "diagnostic"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string" },
        "recoverable": { "type": "boolean" },
        "side_effect_started": { "type": "boolean" },
        "diagnostic": { "type": ["string", "null"] }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "empty" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "pong" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["monotonic_millis"],
              "properties": {
                "monotonic_millis": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "page_state" },
            "payload": { "$ref": "#/$defs/pageState" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "snapshot" },
            "payload": { "$ref": "#/$defs/snapshot" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "binary_payload" },
            "payload": { "$ref": "#/$defs/binaryPayload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "hit_test" },
            "payload": { "$ref": "#/$defs/hitTest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "surface_binding" },
            "payload": { "$ref": "#/$defs/surfaceBinding" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "payload"],
          "properties": {
            "type": { "const": "json" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
