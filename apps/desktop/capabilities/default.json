{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main Magi window permissions",
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "process:default",
    "updater:default",
    "allow-prepare-update-restart",
    "allow-get-staged-desktop-update",
    "allow-get-desktop-update-installability",
    "allow-stage-desktop-update",
    "allow-install-staged-desktop-update",
    "allow-get-desktop-runtime-recovery",
    "allow-restart-desktop-runtime"
  ]
}
